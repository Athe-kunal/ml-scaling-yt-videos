
# ------------------------------------------------------------ __TITLE__ (ManimGL + manim-slides, ← / →)
#   make __NAME__                   render what changed, present fullscreen in the browser
#   make __NAME__ L=L2              one lesson (any part of a scene name)
#   make __NAME__ Q=-l              fast 480p while editing (default: auto = sized to the main screen)
#   make __NAME__-html              same slides in the browser (T = contents sidebar)
.PHONY: __NAME__ __NAME__-qt __NAME__-html __NAME__-install __NAME__-render __NAME__-test __NAME__-clean
__VAR___DIR := __DIR__
__VAR___ARGS = $(L) --quality=$(if $(filter command line environment,$(origin Q)),$(Q),auto)

__NAME__-install:
	cd $(__VAR___DIR) && uv sync

__NAME__-render:
	cd $(__VAR___DIR) && uv run python render.py $(__VAR___ARGS)

__NAME__:
	cd $(__VAR___DIR) && uv run python render.py $(__VAR___ARGS) --present

__NAME__-qt:
	cd $(__VAR___DIR) && uv run python render.py $(__VAR___ARGS) --present --qt

__NAME__-html:
	cd $(__VAR___DIR) && uv run python render.py $(__VAR___ARGS) --html

__NAME__-test:
	cd $(__VAR___DIR) && uv run pytest -q

__NAME__-clean:
	rm -rf $(__VAR___DIR)/slides $(__VAR___DIR)/media $(__VAR___DIR)/videos
